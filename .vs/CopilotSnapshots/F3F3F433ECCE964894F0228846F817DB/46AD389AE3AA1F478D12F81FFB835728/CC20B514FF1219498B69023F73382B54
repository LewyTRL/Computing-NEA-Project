using System.Numerics;
using UnityEditor.Experimental.GraphView;
using UnityEditor.ShaderKeywordFilter;
using UnityEngine;
using UnityEngine.EventSystems;
using static System.Runtime.CompilerServices.RuntimeHelpers;


public class RabbitController : MonoBehaviour
{
    public float movespeed = 5.0f;
    public float jumpforce = 10.0f;
    public Transform groundcheck;
    public float groundcheckradius = 0.2f;
    public LayerMask groundlayer;


 
    private Rigidbody2D rb;
    private bool isgrounded;
    // Start is called once before the first execution of Update after the MonoBehaviour is created
    void Start()
    {
        rb = GetComponent<Rigidbody2D>();


    }

    // Update is called once per frame
    void Update()
    {

        float moveinput = CallRepeater.movdirection;
        rb.linearVelocity = new UnityEngine.Vector2(moveinput * movespeed, rb.linearVelocity.y);

        if (Input.GetKeyDown("space") && isgrounded)
        {
            rb.linearVelocity = new UnityEngine.Vector2(rb.linearVelocity.x, jumpforce);
        }
    }

    private void FixedUpdate()
    {
        isgrounded = Physics2D.OverlapCircle(groundcheck.position, groundcheckradius, groundlayer);
    }

    
}
public class CallRepeater : MonoBehaviour
{

    float interval = 3f;
    public float movdirection = 0;

    float time;

    void Start()
    {
        time = 0f;
    }

    void Update()
    {
        time += Time.deltaTime;
        while (time >= interval)
        {
            randommove();
            time -= interval;
        }
    }

    public void randommove()
    {
        decimal rnd = (decimal)Random.Range(100f, 0f);
        if (rnd > 100) ;
        {
            movdirection = Random.Range(-1.0f, 1.0f);
        }
    }

}
